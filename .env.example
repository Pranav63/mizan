# Backend only. Never prefix secrets with VITE_.
OPENAI_API_KEY=

# Optional local SemIf checkout, installed with its pinned MLX extra.
# make dev starts the scoring bridge when this interpreter is configured.
# Example: /absolute/path/to/SemIf/.venv/bin/python
SEMIF_PYTHON=
SEMIF_BASE_URL=http://127.0.0.1:8019

# Optional: read just the matching key from an existing local dotenv file.
OPENAI_ENV_FILE=
OPENAI_KEY_NAME=OPENAI_API_KEY

OPENAI_MODEL=gpt-5.2-2025-12-11
OPENAI_BASE_URL=https://api.openai.com/v1

# USD per million tokens. Verify pricing before a published run.
OPENAI_INPUT_PRICE=1.75
OPENAI_CACHED_INPUT_PRICE=0.175
OPENAI_OUTPUT_PRICE=14
